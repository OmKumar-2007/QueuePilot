{
  "taskType": "monte-carlo-pi",
  "version": "1.0.0",
  "displayName": "Monte Carlo pi",
  "description": "Estimates pi from random samples. CPU-bound; run time grows linearly with 'samples'.",
  "executorKind": "JAVA_PLUGIN",
  "requiredCapabilities": ["cpu"],
  "inputSchema": {
    "fields": [
      { "name": "samples", "type": "INTEGER", "required": true, "min": 1000, "max": 2000000000, "description": "Number of random points" },
      { "name": "seed", "type": "INTEGER", "required": false, "description": "Random seed" }
    ]
  },
  "outputSchema": {
    "fields": [
      { "name": "estimate", "type": "NUMBER" },
      { "name": "absoluteError", "type": "NUMBER" }
    ]
  },
  "resources": { "cpuMillis": 1000, "memoryMb": 128 },
  "timeoutSeconds": 600,
  "maxRetries": 3,
  "defaultPriority": 5,
  "defaultEstimatedMs": 8000
}
