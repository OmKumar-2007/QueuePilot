<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Spring Boot's parent is used only for its dependency/plugin version management;
         modules that are not Spring applications (core, task-api, worker, benchmarks) do not use Spring. -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.4</version>
        <relativePath/>
    </parent>

    <groupId>com.queuepilot</groupId>
    <artifactId>queuepilot-parent</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>QueuePilot</name>
    <description>Extensible job scheduling and execution platform</description>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <modules>
        <module>src/taskapi</module>
        <module>src/core</module>
        <module>src/tasks</module>
        <module>src/plugins</module>
        <module>src/coordinator</module>
        <module>src/worker</module>
        <module>src/benchmarks</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.queuepilot</groupId>
                <artifactId>queuepilot-task-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.queuepilot</groupId>
                <artifactId>queuepilot-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.queuepilot</groupId>
                <artifactId>queuepilot-tasks-builtin</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!-- Project layout: every module keeps its code flat in src/<name>/ (package <name>), its tests in
         tests/<name>/ and its non-Java files in resources/<name>/. Each module's pom.xml sets module.dir
         to <name>; everything below is shared. All modules compile against the one src/ root, so the
         includes and the -sourcepath override keep each module to its own folder and declared dependencies. -->
    <build>
        <sourceDirectory>${project.basedir}/..</sourceDirectory>
        <testSourceDirectory>${project.basedir}/../../tests</testSourceDirectory>
        <resources>
            <resource>
                <directory>${project.basedir}/../../resources/${module.dir}</directory>
            </resource>
        </resources>
        <testResources>
            <testResource>
                <directory>${project.basedir}/../../tests/${module.dir}</directory>
                <excludes>
                    <exclude>**/*.java</exclude>
                </excludes>
            </testResource>
        </testResources>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <includes>
                            <include>${module.dir}/*.java</include>
                        </includes>
                        <testIncludes>
                            <testInclude>${module.dir}/*.java</testInclude>
                        </testIncludes>
                        <compilerArgs>
                            <arg>-sourcepath</arg>
                            <arg>${project.build.directory}/no-sourcepath</arg>
                        </compilerArgs>
                    </configuration>
                </plugin>
                <!-- Tests run from the repository root, the same place the app is run from. -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <configuration>
                        <workingDirectory>${project.basedir}/../..</workingDirectory>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
